<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/frameLayout5"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".screen.home.aboutBook.AboutBookFragment">

        <!-- AppBar Layout -->

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.Toolbar
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/toolbar"
                android:background="@color/white"
                android:minHeight="?attr/actionBarSize"
                tools:ignore="ExtraText">
                <Button
                    android:id="@+id/backButton"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/arrow_back"
                    tools:ignore="HardcodedText,SpeakableTextPresentCheck" />

                <Button
                    android:id="@+id/menuButton"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="end"
                    android:background="@drawable/menu"
                    tools:ignore="HardcodedText,SpeakableTextPresentCheck" />
                    />
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.AppBarLayout>



        <!-- Staggered RecyclerView -->

        <ImageView
            android:id="@+id/bookImage"
            android:layout_width="140dp"
            android:layout_height="240dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="92dp"
            android:scaleType="centerCrop"
            android:src="@drawable/logo"
            app:layout_constraintBottom_toTopOf="@+id/listenButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0"
            tools:ignore="ContentDescription,ImageContrastCheck,MissingConstraints" />


        <TextView
            android:id="@+id/bookTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="92dp"
            android:layout_marginEnd="28dp"
            android:ellipsize="end"
            android:lines="2"
            android:text="No Longer Human"
            android:textColor="@color/black"
            android:textSize="27dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/appBarLayout"
            tools:ignore="HardcodedText,MissingConstraints,SpUsage,TextSizeCheck" />

        <TextView
            android:id="@+id/authorName"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="152dp"
            android:text="Osamu Dazai"
            android:textColor="@color/about_book_name"
            android:textSize="16sp"
            android:maxLines="3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bookTitle"
            tools:ignore="HardcodedText,MissingConstraints" />

        <androidx.appcompat.widget.AppCompatRatingBar
            android:id="@+id/appCompatRatingBar"
            android:layout_width="235dp"
            android:layout_height="60dp"
            android:layout_marginEnd="12dp"
            android:numStars="5"
            android:rating="4"
            android:progressTint="@color/star"
            app:layout_constraintBottom_toTopOf="@+id/recyclerViewStaggered"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/authorName"
            app:layout_constraintVertical_bias="0.0"
            tools:ignore="MissingClass,MissingConstraints" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewStaggered"
            android:layout_width="231dp"
            android:layout_height="76dp"
            android:layout_marginBottom="32dp"
            app:layout_constraintBottom_toTopOf="@+id/addToLibraryButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/bookImage"
            tools:ignore="MissingConstraints" />

        <TextView
            android:id="@+id/Description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Description"
            android:textColor="@color/grey"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.047"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/listenButton"
            tools:ignore="HardcodedText,MissingConstraints,TextSizeCheck" />

        <Button
            android:id="@+id/listenButton"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:background="@drawable/state_back_login_register"
            android:drawablePadding="8dp"
            android:padding="5dp"
            android:text="Listen"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/addToLibraryButton"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.535"
            tools:ignore="ButtonStyle,DuplicateSpeakableTextCheck,HardcodedText,MissingConstraints,TextContrastCheck,VisualLintButtonSize" />

        <Button
            android:id="@+id/addToLibraryButton"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:background="@drawable/add_to_library"
            android:drawablePadding="8dp"
            android:padding="5dp"
            android:text="Add to Library"
            android:textAllCaps="false"
            android:textColor="@color/iqrealy"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.535"
            tools:ignore="ButtonStyle,HardcodedText,VisualLintButtonSize,TextContrastCheck" />

        <com.ms.square.android.expandabletextview.ExpandableTextView
            android:id="@+id/descriptionTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingLeft="16dp"
            android:paddingTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/Description"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/expandable_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:textColor="#666666"
                android:textSize="16sp" />

            <ImageButton
                android:id="@id/expand_collapse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right|bottom"
                android:background="@android:color/transparent"
                tools:ignore="ContentDescription" />
        </com.ms.square.android.expandabletextview.ExpandableTextView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/aboutRecycler"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/descriptionTextView" />

        <ProgressBar
            android:id="@+id/progressBarAboutBook"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="200dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:visibility="visible"
            android:indeterminateTint="@color/iqrealy"
            app:layout_constraintHorizontal_bias="0.498"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
