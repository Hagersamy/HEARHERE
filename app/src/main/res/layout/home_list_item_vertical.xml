<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/txtVerticalName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:text="Vertical Item"
        android:textColor="@color/black"
        android:textSize="16dp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.072"
        tools:ignore="HardcodedText,SpUsage,TextSizeCheck" />

    <TextView
        android:id="@+id/txtSeeAll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="10dp"
        android:text="see all"
        android:textColor="@color/iqrealy"
        android:textSize="14dp"
        tools:ignore="HardcodedText,SpUsage,TextContrastCheck,TextSizeCheck"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/txtVerticalName"
        app:layout_constraintBottom_toTopOf="@id/underline"
        app:layout_constraintHorizontal_bias="1.0" />

    <View
        android:id="@+id/underline"
        android:layout_width="45dp"
        android:layout_height="1dp"
        android:layout_marginEnd="10dp"
        android:background="@color/iqrealy"
        tools:ignore="VisualLintBounds"
        app:layout_constraintTop_toBottomOf="@id/txtSeeAll"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/txtSeeAll"
        app:layout_constraintHorizontal_bias="1.0" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/itemVerticalRecycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="5dp"
        tools:ignore="RecyclerViewOrientation"
        app:layout_constraintTop_toBottomOf="@id/txtVerticalName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
